# Copy to `.env` for local gltest runs. Never commit `.env`.

# Wallet 1 — the case creator and deployer.
# Needs testnet GEN (Bradbury) for the deploy and for the evaluation transaction.

# Option A (recommended): encrypted keystore JSON, pasted inline or by path.
# For local runs the path is easier; in GitHub Actions use the JSON secret.
KEYSTORE_1=
KEYSTORE_PATH_1=
KEYSTORE_PASSWORD_1=

# Option B: a raw private key. Uncomment only if you are not using a keystore.
# ACCOUNT_PRIVATE_KEY_1=

# Wallet 2 — the adversarial caller used by tests/integration.
# Receives one reverting transaction, so it needs a small amount of testnet GEN.
# Leave empty to skip the outsider test.
KEYSTORE_2=
KEYSTORE_PATH_2=
KEYSTORE_PASSWORD_2=
# ACCOUNT_PRIVATE_KEY_2=

# Optional. Set to 1 to also run a real web + LLM evaluation (costs fees,
# depends on validator agreement).
SPECPROOF_LIVE_EVALUATION=0
